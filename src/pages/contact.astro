---
import Base from '../layouts/Base.astro';
import { url } from '../lib/path';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { company } from '../data/site';
---

<Base
  title="Contact"
  description="Contactez DEBUHCO pour un devis sur les préformes, bouteilles PET et bouchons fabriqués au Burundi."
>
  <PageHero
    eyebrow="Contact"
    title="Parlons de votre projet."
    text="Industriels, distributeurs ou partenaires de collecte : notre équipe vous répond et prépare une offre adaptée à vos volumes."
  />

  <section class="section">
    <div class="container">
      <div class="contact">
        <!-- Form -->
        <div class="contact__form-wrap card" data-reveal>
          <h2 class="contact__h">Demander un devis</h2>
          <p class="contact__sub">Remplissez ce formulaire&nbsp;: nous revenons vers vous sous 48&nbsp;h ouvrées.</p>

          <form
            name="devis"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            action={url("/merci")}
            class="form"
          >
            <input type="hidden" name="form-name" value="devis" />
            <p class="form__hp">
              <label>Ne pas remplir : <input name="bot-field" /></label>
            </p>

            <div class="form__row">
              <div class="field">
                <label for="name">Nom complet *</label>
                <input id="name" name="name" type="text" required autocomplete="name" />
              </div>
              <div class="field">
                <label for="company">Société</label>
                <input id="company" name="company" type="text" autocomplete="organization" />
              </div>
            </div>

            <div class="form__row">
              <div class="field">
                <label for="email">E-mail *</label>
                <input id="email" name="email" type="email" required autocomplete="email" />
              </div>
              <div class="field">
                <label for="phone">Téléphone</label>
                <input id="phone" name="phone" type="tel" autocomplete="tel" />
              </div>
            </div>

            <div class="field">
              <label for="product">Produit concerné</label>
              <select id="product" name="product">
                <option>Préformes PET</option>
                <option>Bouteilles PET</option>
                <option>Bouchons PEHD</option>
                <option>Étiquetage & emballage</option>
                <option>Partenariat de collecte / recyclage</option>
                <option>Autre</option>
              </select>
            </div>

            <div class="field">
              <label for="message">Votre besoin (volumes, formats…) *</label>
              <textarea id="message" name="message" rows="5" required></textarea>
            </div>

            <button type="submit" class="btn btn--primary form__submit">
              Envoyer la demande <Icon name="arrow-right" size={18} />
            </button>
            <p class="form__note">* Champs obligatoires. Vos données ne sont utilisées que pour traiter votre demande.</p>
          </form>
        </div>

        <!-- Info -->
        <aside class="contact__info" data-reveal style="--reveal-delay:120ms">
          <div class="info-card">
            <span class="info-card__icon"><Icon name="map-pin" size={20} /></span>
            <h3>Adresse</h3>
            <p>{company.address.line1}<br />{company.address.line2}<br />{company.address.city}, {company.address.country}</p>
          </div>
          <div class="info-card">
            <span class="info-card__icon"><Icon name="mail" size={20} /></span>
            <h3>E-mail</h3>
            <p><a href={`mailto:${company.email}`}>{company.email}</a></p>
          </div>
          <div class="info-card">
            <span class="info-card__icon"><Icon name="phone" size={20} /></span>
            <h3>Téléphone</h3>
            <p><a href={`tel:${company.phone.replace(/\s/g, '')}`}>{company.phone}</a></p>
          </div>
          <div class="info-card info-card--accent">
            <span class="info-card__icon"><Icon name="factory" size={20} /></span>
            <h3>Zone industrielle</h3>
            <p>Quartier Industriel de Ngagara — un accès direct aux axes routiers vers la sous-région.</p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact { display: grid; gap: 2rem; align-items: start; }
  .contact__h { font-size: var(--step-2); }
  .contact__sub { color: var(--muted); margin-top: 0.5rem; }
  .form { margin-top: 1.8rem; display: grid; gap: 1.1rem; }
  .form__hp { position: absolute; left: -9999px; }
  .form__row { display: grid; gap: 1.1rem; }
  .field { display: grid; gap: 0.4rem; }
  .field label { font-family: var(--font-display); font-size: 0.85rem; font-weight: 500; }
  .field input, .field select, .field textarea {
    font: inherit; font-size: 0.98rem; color: var(--text);
    padding: 0.8rem 0.95rem; border: 1px solid var(--line); border-radius: 12px;
    background: var(--surface); width: 100%; transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .field textarea { resize: vertical; }
  .field input:focus, .field select:focus, .field textarea:focus {
    outline: none; border-color: var(--green); box-shadow: 0 0 0 3px rgba(21,195,122,0.15);
  }
  .form__submit { justify-content: center; margin-top: 0.4rem; }
  .form__note { color: var(--muted); font-size: 0.82rem; }
  @media (min-width: 560px) { .form__row { grid-template-columns: 1fr 1fr; } }

  .contact__info { display: grid; gap: 1rem; }
  .info-card { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.3rem 1.5rem; }
  .info-card__icon { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; background: var(--grad-soft); color: var(--green-deep); margin-bottom: 0.8rem; }
  .info-card h3 { font-size: 1rem; }
  .info-card p { color: var(--muted); margin-top: 0.3rem; font-size: 0.95rem; line-height: 1.5; }
  .info-card a:hover { color: var(--green-deep); }
  .info-card--accent { background: var(--ink); color: var(--text-on-dark); border: 0; }
  .info-card--accent p { color: var(--muted-on-dark); }
  .info-card--accent .info-card__icon { background: rgba(56,224,140,0.14); color: var(--green-bright); }
  @media (min-width: 900px) { .contact { grid-template-columns: 1.4fr 0.9fr; } }
</style>
