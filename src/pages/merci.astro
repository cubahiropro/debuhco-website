---
import Base from '../layouts/Base.astro';
import { url } from '../lib/path';
import Icon from '../components/Icon.astro';
---

<Base title="Merci" description="Votre demande a bien été envoyée à DEBUHCO.">
  <section class="section thanks dark">
    <div class="container thanks__inner" data-reveal>
      <span class="thanks__check"><Icon name="check" size={44} /></span>
      <h1 class="thanks__title">Merci, votre demande est envoyée&nbsp;!</h1>
      <p class="lead thanks__text">
        Notre équipe vous recontacte sous 48&nbsp;h ouvrées avec une offre adaptée.
        En attendant, découvrez notre gamme et notre démarche durable.
      </p>
      <div class="thanks__actions">
        <a href={url("/")} class="btn btn--primary">Retour à l'accueil <Icon name="arrow-right" size={18} /></a>
        <a href={url("/produits")} class="btn btn--on-dark">Voir les produits</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .thanks { min-height: 70vh; display: grid; place-items: center; }
  .thanks__inner { text-align: center; max-width: 54ch; margin-inline: auto; }
  .thanks__check { display: grid; place-items: center; width: 84px; height: 84px; margin: 0 auto 1.6rem; border-radius: 50%; color: #06110d; background: var(--grad); box-shadow: var(--shadow-lg); }
  .thanks__title { font-size: var(--step-3); }
  .thanks__text { color: var(--muted-on-dark); margin: 1.2rem auto 0; }
  .thanks__actions { display: flex; flex-wrap: wrap; gap: 0.9rem; justify-content: center; margin-top: 2rem; }
</style>
