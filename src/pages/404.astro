---
import Base from '../layouts/Base.astro';
import { url } from '../lib/path';
import Icon from '../components/Icon.astro';
import Illustration from '../components/Illustration.astro';
---

<Base title="Page introuvable" description="Cette page n'existe pas.">
  <section class="section nf dark">
    <div class="container nf__inner">
      <div class="nf__illu">
        <Illustration name="not-found" label="Illustration d'une page introuvable" />
      </div>
      <p class="nf__code gradient-text">404</p>
      <h1 class="nf__title">Cette page a été soufflée ailleurs.</h1>
      <p class="lead nf__text">La page que vous cherchez est introuvable ou a été déplacée.</p>
      <a href={url("/")} class="btn btn--primary">Retour à l'accueil <Icon name="arrow-right" size={18} /></a>
    </div>
  </section>
</Base>

<style>
  .nf { min-height: 72vh; display: grid; place-items: center; text-align: center; }
  .nf__illu { max-width: 340px; margin: 0 auto 1.4rem; }
  .nf__illu .illu { color: var(--green-bright); }
  .nf__code { font-family: var(--font-display); font-weight: 800; font-size: clamp(4rem, 14vw, 9rem); line-height: 1; }
  .nf__title { font-size: var(--step-3); margin-top: 0.5rem; }
  .nf__text { color: var(--muted-on-dark); margin: 1rem auto 2rem; max-width: 44ch; }
</style>
