---
import Icon from './Icon.astro';
import { company } from '../data/site';
import { url } from '../lib/path';
---

<section class="hero dark" data-hero>
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__glow hero__glow--1" data-parallax="-18"></div>
    <div class="hero__glow hero__glow--2" data-parallax="22"></div>
    <div class="hero__grid"></div>
  </div>

  <div class="container container--wide hero__inner">
    <div class="hero__copy">
      <p class="chip hero__chip" data-hero-badge>
        <Icon name="map-pin" size={15} /> Bujumbura · Burundi
      </p>

      <h1 class="hero__title">
        <span class="hero__line" data-hero-line><span>L'emballage PET</span></span>
        <span class="hero__line" data-hero-line><span>durable, <em class="gradient-text">fabriqué</em></span></span>
        <span class="hero__line" data-hero-line><span>au Burundi.</span></span>
      </h1>

      <p class="lead hero__sub" data-hero-sub>
        {company.legalName} ouvre la première unité industrielle du pays dédiée aux
        préformes, bouchons et bouteilles PET — en combinant matière vierge et
        recyclage pour une économie circulaire.
      </p>

      <div class="hero__cta">
        <a href={url("/contact")} class="btn btn--primary" data-hero-cta>
          Demander un devis <Icon name="arrow-right" size={18} />
        </a>
        <a href={url("/produits")} class="btn btn--on-dark" data-hero-cta>
          Découvrir la gamme
        </a>
      </div>

      <dl class="hero__badges">
        <div class="hero__badge" data-hero-badge>
          <dt>19&nbsp;M</dt><dd>bouteilles / an</dd>
        </div>
        <div class="hero__badge" data-hero-badge>
          <dt>−10 à −15 %</dt><dd>vs importations</dd>
        </div>
        <div class="hero__badge" data-hero-badge>
          <dt>70 %</dt><dd>PET recyclé</dd>
        </div>
      </dl>
    </div>

    <div class="hero__art" data-hero-art>
      <div class="hero__art-ring" aria-hidden="true"></div>
      <svg class="hero__bottle" viewBox="0 0 220 420" role="img"
        aria-label="Illustration d'une bouteille PET et d'un cycle de recyclage">
        <defs>
          <linearGradient id="bottleFill" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#ff9a3d" stop-opacity="0.95" />
            <stop offset="1" stop-color="#f46104" stop-opacity="0.95" />
          </linearGradient>
          <linearGradient id="liquid" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#ff9a3d" stop-opacity="0.3" />
            <stop offset="1" stop-color="#f46104" stop-opacity="0.55" />
          </linearGradient>
        </defs>

        <!-- bottle body -->
        <path
          d="M86 70 h48 v16 c0 10 10 14 10 30 v250 c0 24 -14 38 -34 38 h0
             c-20 0 -34 -14 -34 -38 V116 c0 -16 10 -20 10 -30 Z"
          fill="none" stroke="url(#bottleFill)" stroke-width="3" />
        <!-- liquid -->
        <path
          d="M72 210 v194 c0 24 14 38 34 38 h8 c20 0 34 -14 34 -38 V210 Z"
          fill="url(#liquid)" opacity="0.55" />
        <!-- cap -->
        <rect x="90" y="40" width="40" height="30" rx="7"
          fill="url(#bottleFill)" />
        <rect x="90" y="40" width="40" height="8" rx="4" fill="#06110d" opacity="0.25" />
        <!-- ribs -->
        <g stroke="url(#bottleFill)" stroke-width="2" opacity="0.5">
          <line x1="80" y1="250" x2="140" y2="250" />
          <line x1="80" y1="266" x2="140" y2="266" />
          <line x1="80" y1="282" x2="140" y2="282" />
        </g>
      </svg>

      <!-- floating preform -->
      <svg class="hero__preform" viewBox="0 0 60 120" aria-hidden="true">
        <rect x="18" y="4" width="24" height="18" rx="5" fill="#ff9a3d" />
        <path d="M20 22 h20 v70 c0 12 -4 24 -10 24 s-10 -12 -10 -24 Z"
          fill="none" stroke="#f46104" stroke-width="2.6" />
      </svg>

      <!-- recycle badge -->
      <div class="hero__rec" aria-hidden="true">
        <Icon name="recycle" size={30} />
      </div>
    </div>
  </div>

  <a href="#stats" class="hero__scroll" aria-label="Défiler vers le bas">
    <span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 7vw, 6rem) clamp(4rem, 8vw, 7rem);
    isolation: isolate;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 54px 54px;
    mask-image: radial-gradient(ellipse 80% 70% at 60% 30%, #000 40%, transparent 100%);
  }
  .hero__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.5;
  }
  .hero__glow--1 {
    width: 520px;
    height: 520px;
    top: -160px;
    right: -80px;
    background: radial-gradient(circle, rgba(244, 97, 4, 0.5), transparent 70%);
  }
  .hero__glow--2 {
    width: 420px;
    height: 420px;
    bottom: -140px;
    left: -100px;
    background: radial-gradient(circle, rgba(255, 154, 61, 0.38), transparent 70%);
  }

  .hero__inner {
    display: grid;
    gap: 2rem;
    align-items: center;
    grid-template-columns: 1fr;
  }
  .hero__chip {
    background: rgba(255, 125, 26, 0.14);
    color: var(--green-bright);
    border-color: rgba(255, 125, 26, 0.32);
  }
  .hero__title {
    font-size: var(--step-5);
    margin-top: 1.4rem;
    font-weight: 700;
  }
  .hero__line {
    display: block;
    overflow: hidden;
    padding-block: 0.04em;
  }
  .hero__line > span {
    display: block;
  }
  .hero__title em {
    font-style: normal;
  }
  .hero__sub {
    margin-top: 1.6rem;
    color: var(--muted-on-dark);
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2rem;
  }
  .hero__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 1.8rem 2.4rem;
    margin: 2.6rem 0 0;
    padding-top: 1.8rem;
    border-top: 1px solid var(--line-on-dark);
  }
  .hero__badge dt {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .hero__badge dd {
    margin: 0.2rem 0 0;
    color: var(--muted-on-dark);
    font-size: 0.9rem;
  }

  /* art */
  .hero__art {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 360px;
  }
  .hero__art-ring {
    position: absolute;
    width: min(360px, 78%);
    aspect-ratio: 1;
    border-radius: 50%;
    background: conic-gradient(from 120deg, rgba(244, 97, 4, 0.28), rgba(255, 154, 61, 0.28), rgba(244, 97, 4, 0.28));
    filter: blur(4px);
    animation: spin 26s linear infinite;
  }
  .hero__art-ring::after {
    content: '';
    position: absolute;
    inset: 14%;
    border-radius: 50%;
    background: var(--ink);
  }
  .hero__bottle {
    position: relative;
    width: clamp(160px, 42vw, 230px);
    filter: drop-shadow(0 30px 50px rgba(0, 0, 0, 0.4));
    animation: float 6s ease-in-out infinite;
  }
  .hero__preform {
    position: absolute;
    width: 52px;
    right: 12%;
    top: 12%;
    animation: float 5s ease-in-out infinite 0.6s;
    filter: drop-shadow(0 12px 22px rgba(0, 0, 0, 0.35));
  }
  .hero__rec {
    position: absolute;
    left: 8%;
    bottom: 14%;
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 16px;
    color: #06110d;
    background: var(--grad);
    box-shadow: var(--shadow-lg);
    animation: float 5.4s ease-in-out infinite 0.3s;
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 1.4rem;
    transform: translateX(-50%);
    width: 26px;
    height: 42px;
    border: 2px solid var(--line-on-dark);
    border-radius: 999px;
    display: grid;
    justify-items: center;
    padding-top: 7px;
  }
  .hero__scroll span {
    width: 4px;
    height: 8px;
    border-radius: 2px;
    background: var(--green-bright);
    animation: scroll 1.8s ease-in-out infinite;
  }

  @keyframes float {
    50% { transform: translateY(-14px); }
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  @keyframes scroll {
    0% { opacity: 0; transform: translateY(-4px); }
    40% { opacity: 1; }
    80% { opacity: 0; transform: translateY(10px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__bottle, .hero__preform, .hero__rec, .hero__art-ring, .hero__scroll span { animation: none; }
  }

  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 3rem;
    }
    .hero__art { min-height: 520px; }
  }
</style>
