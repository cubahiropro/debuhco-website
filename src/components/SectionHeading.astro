---
interface Props {
  eyebrow?: string;
  title: string;
  align?: 'left' | 'center';
  dark?: boolean;
  max?: string;
}
const { eyebrow, title, align = 'left', dark = false, max = '26ch' } = Astro.props;
---

<div class:list={['sh', `sh--${align}`]} data-reveal>
  {eyebrow && <span class:list={['eyebrow', { 'eyebrow--on-dark': dark }]}>{eyebrow}</span>}
  <h2 class="sh__title" style={`--max:${max}`}>
    <slot name="title">{title}</slot>
  </h2>
  <slot />
</div>

<style>
  .sh {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .sh--center {
    align-items: center;
    text-align: center;
    margin-inline: auto;
  }
  .sh__title {
    font-size: var(--step-3);
    max-width: var(--max);
  }
  .sh--center .sh__title {
    max-width: 24ch;
  }
</style>
